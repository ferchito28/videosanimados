      "lineas": [
        {"personaje": "lustig", "texto": "París, 1925. Leí que la torre cuesta una fortuna mantenerla.", "brazo": "arriba"},
        {"personaje": "lustig", "texto": "Así que tuve una idea brillante.", "expresion": "feliz"}
      ]
    },
    {
      "fondo": "oficina",
      "personajes": [
        {"id": "lustig", "x": 0.25, "escala": 0.95, "expresion": "sospechoso"},
        {"id": "poisson", "x": 0.76, "escala": 0.95, "voltear": true}
      ],
      "lineas": [
        {"personaje": "lustig", "texto": "El gobierno la vende como chatarra. Es secreto.", "brazo": "señala"},
        {"personaje": "poisson", "texto": "¿¡La Torre Eiffel!? ¡La compro!", "expresion": "sorprendido"},
        {"personaje": "lustig", "texto": "Excelente. Y un pequeño soborno, monsieur.", "expresion": "feliz"}
      ]
    },
    {
      "fondo": "noche",
      "personajes": [{"id": "poisson", "x": 0.5, "escala": 1.35, "expresion": "triste"}],
      "lineas": [
        {"personaje": "poisson", "texto": "Me estafaron... y me da vergüenza denunciarlo.", "expresion": "triste"}
      ]
    },
    {
      "fondo": "campo",
      "personajes": [
        {"id": "lustig", "x": 0.25, "escala": 0.95, "expresion": "feliz"},
        {"id": "gendarme", "x": 0.76, "escala": 0.95, "voltear": true, "expresion": "enojado"}
      ],
      "lineas": [
        {"personaje": "gendarme", "texto": "¿Y qué hizo un mes después?", "expresion": "enojado"},
        {"personaje": "lustig", "texto": "¡Volví a venderla otra vez!", "expresion": "feliz", "brazo": "arriba"}
      ]
    }
  ]
